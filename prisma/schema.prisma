// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum SlipStatus {
  PAGO
  PENDENTE
  RESERVADO
}

model User {
  id                String   @id @default(uuid())
  username          String   @unique
  passwordHash      String
  tutorialCompleted Boolean  @default(false)
  createdAt         DateTime @default(now())

  categories       Category[]
  slips            PaymentSlip[]
  achievements     Achievement[]
  stats            UserStats?
  extraIncomes     ExtraIncome[]
  apartmentProject ApartmentProject?
  deviceTokens     DeviceToken[]
  monthlyBudgets   MonthlyBudget[]
  categoryBudgets  MonthlyCategoryBudget[]
  pets             Pet[]
  petVaccines      PetVaccine[]
  petAppointments  PetAppointment[]
}

model Category {
  id              String        @id @default(uuid())
  name            String
  colorCode       String        // CSS color variable or hex code
  iconRef         String        // Lucide icon name
  isSystemDefault Boolean       @default(false) // Protects seed categories from deletion
  createdAt       DateTime      @default(now())  // Audit timestamp
  
  budgetLimit     Float?        // Optional category monthly budget limit in R$
  
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  slips           PaymentSlip[]
  monthlyBudgets  MonthlyCategoryBudget[]

  @@unique([name, userId])
}

model PaymentSlip {
  id                  String     @id @default(uuid())
  title               String
  amount              Float      // Payment amount in standard decimal
  dueDate             DateTime
  status              SlipStatus @default(PENDENTE)
  isCreditCardPayment Boolean    @default(false)
  isDebt              Boolean    @default(false)
  isRecurring         Boolean    @default(false)  // Repeats monthly
  recurringDay        Int?       // Day of month (1-31) for recurring generation
  isInstallment       Boolean    @default(false)
  installmentNumber   Int?
  installmentTotal    Int?
  installmentGroupId  String?
  documentPath        String?    // Optional filesystem path to uploaded PDF/Image
  createdAt           DateTime   @default(now())

  categoryId String
  category   Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  petVaccines PetVaccine[]
}

model Achievement {
  id                 String    @id @default(uuid())
  title              String
  description        String
  type               String    // "STREAK", "CARD_THRESHOLD", "SAVINGS"
  conditionValue     Float     // Threshold limit or target days
  level              Int       @default(1) // Level of achievement in the trail (1, 2, 3)
  isUnlocked         Boolean   @default(false)
  progressPercentage Float     @default(0.0)
  unlockedAt         DateTime?

  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([title, userId])
}

model UserStats {
  id                 String @id // Maps directly to User.id
  monthlyBudgetLimit Float  @default(50.0) // Percentage of scheduledSalaryAmount (0-100)
  totalCreditLimit   Float  @default(1000.0)
  currentStreakDays  Int    @default(0)

  // Gamification fields
  level                Int      @default(1)
  xp                   Int      @default(0)

  // Leisure budget
  leisureBudget            Float    @default(0.0) // Monthly leisure budget in R$

  // Salary fields
  scheduledSalaryAmount     Float   @default(3000.0)
  salaryPaymentDay          Int     @default(5)
  lastSalaryValidationMonth String? // Format: YYYY-MM

  user               User   @relation(fields: [id], references: [id], onDelete: Cascade)
}

model ExtraIncome {
  id          String   @id @default(uuid())
  amount      Float    // Extra income amount in BRL
  description String   // e.g. "Freela", "Venda de produto", "Bônus"
  month       String   // Format: YYYY-MM (which month this income applies to)
  createdAt   DateTime @default(now())

  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApartmentProject {
  id                 String             @id @default(uuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyValue      Float              @default(0.0)
  downPayment        Float              @default(0.0)
  financedAmount     Float              @default(0.0)
  interestRate       Float              @default(0.0)
  loanTermMonths     Int                @default(0)
  amortizationType   String             @default("SAC")
  installmentsPaid   Int                @default(0)
  installmentsTotal  Int                @default(0)
  obraBudget         Float              @default(0.0)
  createdAt          DateTime           @default(now())

  stages             ApartmentStage[]
  expenses           ApartmentExpense[]
  installments       ApartmentInstallment[]
}

model ApartmentStage {
  id          String             @id @default(uuid())
  name        String
  budget      Float              @default(0.0)
  status      String             @default("PENDENTE")
  projectId   String
  project     ApartmentProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  expenses    ApartmentExpense[]
  createdAt   DateTime           @default(now())
}

model ApartmentExpense {
  id          String             @id @default(uuid())
  description String
  amount      Float
  status      String             @default("PENDENTE")
  type        String             @default("OBRA") // "OBRA" | "DOCUMENTACAO" | "MOVEIS" | "DECORACAO" | "GERAL"
  date        DateTime           @default(now())
  notes       String?
  
  projectId   String
  project     ApartmentProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  stageId     String?
  stage       ApartmentStage?    @relation(fields: [stageId], references: [id], onDelete: SetNull)
  
  options     ApartmentExpenseOption[]

  createdAt   DateTime           @default(now())

  @@index([projectId])
  @@index([stageId])
}

model ApartmentExpenseOption {
  id        String           @id @default(uuid())
  name      String
  price     Float
  url       String?
  selected  Boolean          @default(false)
  
  expenseId String
  expense   ApartmentExpense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  
  createdAt DateTime         @default(now())

  @@index([expenseId])
}

model ApartmentInstallment {
  id                String             @id @default(uuid())
  installmentNumber Int
  dueDate           DateTime
  amount            Float
  status            String             @default("PENDENTE") // "PENDENTE" | "PAGO"
  
  projectId         String
  project           ApartmentProject   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  createdAt         DateTime           @default(now())
}

model DeviceToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model RecurringSkip {
  id          String   @id @default(uuid())
  title       String
  categoryId  String
  userId      String
  year        Int
  month       Int
  createdAt   DateTime @default(now())

  @@unique([title, categoryId, userId, year, month])
}

model MonthlyBudget {
  id                    String   @id @default(uuid())
  userId                String
  month                 String   // Format: YYYY-MM
  monthlyBudgetLimit    Float    @default(50.0) // Percentage (0-100)
  scheduledSalaryAmount Float    @default(3000.0)
  leisureBudget         Float    @default(0.0)
  totalCreditLimit      Float    @default(1000.0)
  createdAt             DateTime @default(now())

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month])
}

model MonthlyCategoryBudget {
  id          String   @id @default(uuid())
  categoryId  String
  userId      String
  month       String   // Format: YYYY-MM
  budgetLimit Float
  createdAt   DateTime @default(now())

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month, userId])
}

model Pet {
  id          String    @id @default(uuid())
  name        String
  species     String?   @default("Cachorro") // "Cachorro", "Gato", etc.
  breed       String?   // Raça
  birthDate   DateTime?
  weight      Float?    // Peso em kg
  rga         String?   // Registro Geral Animal
  photoUrl    String?   // Foto ou avatar URL / emoji
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  vaccines     PetVaccine[]
  appointments PetAppointment[]

  @@index([userId])
}

model PetVaccine {
  id                  String       @id @default(uuid())
  name                String       // Nome da vacina ou vermífugo
  type                String       @default("VACINA") // "VACINA" | "VERMIFUGO" | "OUTRO"
  applicationDate     DateTime     // Data de aplicação
  boosterDate         DateTime?    // Data do reforço
  boosterDone         Boolean      @default(false) // Se o reforço já foi realizado
  notes               String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  // Integração com Despesas Financeiras
  isExpense           Boolean      @default(false)
  amount              Float?
  isCreditCardPayment Boolean      @default(false)
  slipId              String?      // ID da despesa PaymentSlip vinculada
  slip                PaymentSlip? @relation(fields: [slipId], references: [id], onDelete: SetNull)

  petId               String
  pet                 Pet          @relation(fields: [petId], references: [id], onDelete: Cascade)

  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([userId])
  @@index([boosterDate])
  @@index([slipId])
}

enum AppointmentStatus {
  PENDENTE
  COMPARECEU
  FALTOU
}

model PetAppointment {
  id          String            @id @default(uuid())
  title       String            // Ex: "Creche", "Veterinário", "Banho e tosa"
  type        String            @default("CRECHE") // "CRECHE" | "VETERINARIO" | "BANHO_TOSA" | "OUTRO"
  date        DateTime          // Data do compromisso
  time        String?           // Horário (ex: "08:00")
  status      AppointmentStatus @default(PENDENTE)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  petId       String
  pet         Pet               @relation(fields: [petId], references: [id], onDelete: Cascade)

  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([petId])
  @@index([userId])
  @@index([date])
}

